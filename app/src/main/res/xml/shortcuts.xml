<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="quick_note"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_edit"
        android:shortcutShortLabel="@string/shortcut_new_note_short"
        android:shortcutLongLabel="@string/shortcut_new_note_long">
        <intent
            android:action="com.example.ACTION_QUICK_NOTE"
            android:targetPackage="com.aistudio.NotasJS.kxmpzq"
            android:targetClass="com.example.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:shortcutId="quick_voice"
        android:enabled="true"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:shortcutShortLabel="@string/shortcut_voice_note_short"
        android:shortcutLongLabel="@string/shortcut_voice_note_long">
        <intent
            android:action="com.example.ACTION_QUICK_VOICE"
            android:targetPackage="com.aistudio.NotasJS.kxmpzq"
            android:targetClass="com.example.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:shortcutId="quick_scan"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_camera"
        android:shortcutShortLabel="@string/shortcut_scan_document_short"
        android:shortcutLongLabel="@string/shortcut_scan_document_long">
        <intent
            android:action="com.example.ACTION_QUICK_SCAN"
            android:targetPackage="com.aistudio.NotasJS.kxmpzq"
            android:targetClass="com.example.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

</shortcuts>